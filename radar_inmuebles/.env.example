# =============================================================
#  RADAR INMUEBLES — secretos. Copiá este archivo a .env
#  El .env NO se sube a git (está en .gitignore).
# =============================================================

# --- WhatsApp vía CallMeBot (la opción gratis y más simple) ---
# 1) Agendá +34 644 51 95 23 como "CallMeBot"
# 2) Mandale por WhatsApp: I allow callmebot to send me messages
# 3) Te contesta con tu apikey. Pegala acá.
CALLMEBOT_APIKEY=

# --- WhatsApp vía Twilio (pago, más confiable si mandás mucho) ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- WhatsApp Cloud API (Meta) ---
# WA_PHONE_NUMBER_ID=
# WA_TOKEN=
# WA_TEMPLATE=

# --- Telegram (respaldo gratis e ilimitado) ---
# TELEGRAM_TOKEN=
# TELEGRAM_CHAT_ID=

# --- MercadoLibre (solo si la API empieza a pedir token) ---
# Creá una app en https://developers.mercadolibre.com.ar
# ML_ACCESS_TOKEN=

# --- Opcional: proxy residencial si los portales te bloquean la IP ---
# RADAR_PROXY=http://usuario:clave@host:puerto

# --- Opcional: ruta a Chromium si Playwright no lo encuentra ---
# CHROMIUM_PATH=

# =============================================================
#  RADAR INMUEBLES — secretos. Copiá este archivo a .env
#  El .env NO se sube a git (está en .gitignore).
#
#  OJO: las líneas que empiezan con # son comentarios y se ignoran.
#  Si pegás una clave, asegurate de que la línea NO empiece con #.
# =============================================================

# --- Telegram (canal principal) ---
# El token te lo da @BotFather al crear el bot.
TELEGRAM_TOKEN=
# El chat_id lo completa solo:
#    python -m radar_inmuebles telegram-chatid --guardar
TELEGRAM_CHAT_ID=

# --- WhatsApp vía CallMeBot ---
# Pedila en callmebot.com/blog/free-api-whatsapp-messages/
# (a veces el bot está lleno y no entrega claves nuevas)
CALLMEBOT_APIKEY=

# --- WhatsApp vía Twilio (pago) ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- WhatsApp Cloud API (Meta) ---
# WA_PHONE_NUMBER_ID=
# WA_TOKEN=
# WA_TEMPLATE=aviso_propiedad
# WA_TEMPLATE_LANG=es

# --- MercadoLibre (solo si la API empieza a pedir token) ---
# ML_ACCESS_TOKEN=

# --- Proxy residencial, si los portales te bloquean la IP ---
# RADAR_PROXY=http://usuario:clave@host:puerto

# --- Ruta a Chromium si Playwright no lo encuentra ---
# CHROMIUM_PATH=
